<Project>
  <PropertyGroup>
    <UnicodeBidiNetUpstreamCrate Condition="'$(UnicodeBidiNetUpstreamCrate)' == ''">unicode-bidi</UnicodeBidiNetUpstreamCrate>
    <UnicodeBidiNetUpstreamVersion Condition="'$(UnicodeBidiNetUpstreamVersion)' == ''">0.3.18</UnicodeBidiNetUpstreamVersion>
    <UnicodeBidiNetUnicodeVersion Condition="'$(UnicodeBidiNetUnicodeVersion)' == ''">16.0.0</UnicodeBidiNetUnicodeVersion>

    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.3.18</VersionPrefix>
    <VersionSuffix Condition="'$(VersionSuffix)' == ''">preview</VersionSuffix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.3.18.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.3.18.0</FileVersion>

    <Authors>Erik A. Brandstadmoen; unicode-bidi contributors; Unicode.Bidi contributors</Authors>
    <Company>Erik A. Brandstadmoen</Company>
    <Copyright>Copyright (c) 2006 Erik A. Brandstadmoen</Copyright>
    <PackageProjectUrl>https://github.com/erikbra/unicode-bidi-net</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/erikbra/unicode-bidi-net</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Tracks $(UnicodeBidiNetUpstreamCrate) $(UnicodeBidiNetUpstreamVersion) with Unicode data $(UnicodeBidiNetUnicodeVersion).</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RepositoryBranch)' == '' and '$(GITHUB_REF_NAME)' != ''">
    <RepositoryBranch>$(GITHUB_REF_NAME)</RepositoryBranch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
