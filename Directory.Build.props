<Project>
  <PropertyGroup>
    <UnicodeBidiNetUpstreamCrate Condition="'$(UnicodeBidiNetUpstreamCrate)' == ''">unicode-bidi</UnicodeBidiNetUpstreamCrate>
    <UnicodeBidiNetUpstreamVersion Condition="'$(UnicodeBidiNetUpstreamVersion)' == ''">0.3.18</UnicodeBidiNetUpstreamVersion>
    <UnicodeBidiNetUnicodeVersion Condition="'$(UnicodeBidiNetUnicodeVersion)' == ''">18.0.0</UnicodeBidiNetUnicodeVersion>

    <VersionPrefix Condition="'$(VersionPrefix)' == ''">0.4.0</VersionPrefix>
    <AssemblyVersion Condition="'$(AssemblyVersion)' == ''">0.4.0.0</AssemblyVersion>
    <FileVersion Condition="'$(FileVersion)' == ''">0.4.0.0</FileVersion>

    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsAsErrors>$(WarningsAsErrors);NU1900;NU1901;NU1902;NU1903;NU1904;NU1905</WarningsAsErrors>

    <Authors>Erik A. Brandstadmoen; unicode-bidi contributors; Unicode.Bidi contributors</Authors>
    <Company>Erik A. Brandstadmoen</Company>
    <Copyright>Copyright (c) 2006 Erik A. Brandstadmoen</Copyright>
    <PackageProjectUrl>https://github.com/erikbra/unicode-bidi-net</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/erikbra/unicode-bidi-net</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Algorithm ported from $(UnicodeBidiNetUpstreamCrate) $(UnicodeBidiNetUpstreamVersion); Unicode data $(UnicodeBidiNetUnicodeVersion) generated directly from the Unicode Character Database.</PackageReleaseNotes>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RepositoryBranch)' == '' and '$(GITHUB_REF_NAME)' != ''">
    <RepositoryBranch>$(GITHUB_REF_NAME)</RepositoryBranch>
  </PropertyGroup>

  <PropertyGroup Condition="'$(ContinuousIntegrationBuild)' == '' and '$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>
</Project>
